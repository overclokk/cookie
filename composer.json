{
    "name": "overclokk/cookie",
    "description": "A simple and light cookie manager class",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "symplify/easy-coding-standard": "^12.5",
        "rector/rector": "^2.0",
        "codeception/codeception": "dev-main",
        "codeception/module-asserts": "^3.0",
        "squizlabs/php_codesniffer": "^3.11",
        "phpcompatibility/php-compatibility": "dev-develop",
        "dealerdirect/phpcodesniffer-composer-installer": "^v1.0"
    },
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "overclokk",
            "email": "info@overclokk.net"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Overclokk\\Cookie\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Overclokk\\Cookie\\Tests\\": "tests/src/",
            "Overclokk\\Cookie\\Tests\\Unit\\": "tests/unit/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "qa": [
            "@cs",
            "@unit",
            "@clean",
            "@examples"
        ],
        "tests": [
            "@unit"
        ],
        "ecs": [
            "@php vendor/bin/ecs"
        ],
        "cs": [
            "@php vendor/bin/phpcs"
        ],
        "cs:fix": [
            "@php vendor/bin/phpcbf"
        ],
        "compat": [
            "@php vendor/bin/phpcs -p ./src/ --standard=PHPCompatibility --runtime-set testVersion 8.4"
        ],
        "unit": [
            "@php vendor/bin/codecept run unit"
        ],
        "unit:debug": [
            "@php vendor/bin/codecept run unit --debug"
        ],
        "clean": [
            "@php vendor/bin/codecept clean"
        ],
        "rector": [
            "@php vendor/bin/rector process --dry-run"
        ],
        "rector:fix": [
            "@php vendor/bin/rector process"
        ],
        "rector:downgrade": [
            "@php vendor/bin/rector process --config=.build/rector-74.php"
        ],
        "examples": [
            "@php examples.php"
        ]
    }
}
